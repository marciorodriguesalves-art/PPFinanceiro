# Copie para .env NO VPS e ajuste. NUNCA versione o .env real.
# Gere a SECRET_KEY com:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"

APP_NAME="Controle Orçamentário"
ENVIRONMENT=production
SECRET_KEY=TROQUE-por-uma-chave-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- PostgreSQL (o host é "db", nome do serviço no docker-compose.prod.yml) ---
POSTGRES_USER=orcamento
POSTGRES_PASSWORD=TROQUE-esta-senha
POSTGRES_DB=orcamento
DATABASE_URL=postgresql+psycopg://orcamento:TROQUE-esta-senha@db:5432/orcamento

# Regra de investimento mínimo (fração da receita líquida)
MIN_INVESTMENT_RATE=0.10

# --- Administrador inicial (criado por scripts/create_admin.py) ---
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=TROQUE-no-primeiro-login
ADMIN_NAME=Administrador

# --- Caddy / HTTPS ---
# Com domínio apontando para o VPS: use o domínio (TLS automático).
# Sem domínio (acesso por IP): use  :80
SITE_ADDRESS=orcamento.seudominio.com
ACME_EMAIL=voce@seudominio.com
